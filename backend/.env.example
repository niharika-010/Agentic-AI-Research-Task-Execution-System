# Database (SQLite by default for local dev; PostgreSQL on Render)
DATABASE_URL=sqlite:///./research_system.db

# LLM Providers (Optional - Intelligent fallback active if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto

# Web Search API (Tavily; open web search fallback active if empty)
TAVILY_API_KEY=

# CORS & Server
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000
